rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function hasApprovedUid() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/authorizedVolunteers/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/authorizedVolunteers/$(request.auth.uid)
        ).data.active == true;
    }

    function hasApprovedEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && firestore.exists(
          /databases/(default)/documents/authorizedVolunteerEmails/$(request.auth.token.email)
        )
        && firestore.get(
          /databases/(default)/documents/authorizedVolunteerEmails/$(request.auth.token.email)
        ).data.active == true;
    }

    function isApprovedVolunteer() {
      return hasApprovedUid() || hasApprovedEmail();
    }

    match /library-photos/{photoFile} {
      allow read: if true;

      allow create, update: if isApprovedVolunteer()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp)'
        );

      allow delete: if isApprovedVolunteer();
    }
  }
}