rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isApprovedVolunteer() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/authorizedVolunteers/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/authorizedVolunteers/$(request.auth.uid)
        ).data.active == true;
    }

    match /library-photos/{photoFile} {
      allow read: if true;

      allow create, update: if isApprovedVolunteer()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if isApprovedVolunteer();
    }
  }
}
