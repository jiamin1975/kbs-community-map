rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasApprovedUid() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/authorizedVolunteers/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/authorizedVolunteers/$(request.auth.uid)
        ).data.active == true;
    }

    function hasApprovedEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(
          /databases/$(database)/documents/authorizedVolunteerEmails/$(request.auth.token.email)
        )
        && get(
          /databases/$(database)/documents/authorizedVolunteerEmails/$(request.auth.token.email)
        ).data.active == true;
    }

    function isApprovedVolunteer() {
      return hasApprovedUid() || hasApprovedEmail();
    }

    function isValidPublicBookBoxCreate() {
      return request.auth != null
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 300
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.books is list
        && request.resource.data.books.size() <= 250
        && request.resource.data.bookCount ==
          request.resource.data.books.size()
        && request.resource.data.photoFile is string;
    }

    match /libraries/{libraryId} {
      allow read: if true;
      allow create: if isValidPublicBookBoxCreate();
      allow update: if isApprovedVolunteer();
      allow delete: if false;

      match /activity/{activityId} {
        allow read: if isApprovedVolunteer();
        allow create, update, delete: if false;
      }
    }

    match /authorizedVolunteers/{volunteerId} {
      allow read: if request.auth != null
        && request.auth.uid == volunteerId;
      allow write: if false;
    }

    match /authorizedVolunteerEmails/{volunteerEmail} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == volunteerEmail;
      allow write: if false;
    }
  }
}
